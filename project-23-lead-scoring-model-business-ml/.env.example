# ============================================================================
# LeadForge AI - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your-super-secret-key-change-in-production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://leadforge:password@localhost:5432/leadforge_db
SQLALCHEMY_ECHO=False

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_TIMEOUT=300

# Model Paths
MODEL_PATH=models/xgboost_model.pkl
SCALER_PATH=models/scaler.pkl
CALIBRATOR_PATH=models/calibrator.pkl
FEATURE_NAMES_PATH=models/feature_names.json

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8050,http://localhost:8000

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# Production Settings (uncomment and update for prod)
# ENVIRONMENT=production
# API_SECRET_KEY=<generate-strong-key>
# DATABASE_URL=postgresql://user:pass@prod-db-host:5432/leadforge_db
# REDIS_URL=redis://<prod-redis-host>:6379/0
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
