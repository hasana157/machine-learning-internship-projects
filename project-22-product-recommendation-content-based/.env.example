# Django Settings
DEBUG=False
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com

# Database
MONGO_URI=mongodb://admin:shopsense_dev@mongodb:27017/shopsense_ai?authSource=admin
MONGO_PASSWORD=shopsense_dev

# Cache
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Search
ELASTICSEARCH_HOST=elasticsearch:9200

# ML Configuration
ML_ARTIFACTS_DIR=/ml/artefacts
EMBEDDING_MODEL=all-MiniLM-L6-v2
TFIDF_MAX_FEATURES=50000

# Logging
LOG_LEVEL=INFO

# Sentry (Optional - for error tracking)
SENTRY_DSN=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8080

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
API_BASE_URL=http://localhost:8000/api/v1
