# ============================================================================
# CineMatch AI - Environment Configuration
# ============================================================================
# Copy this file to .env and update values for your environment

# ============================================================================
# ENVIRONMENT & GENERAL
# ============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=False

# ============================================================================
# DATABASE - PostgreSQL
# ============================================================================
POSTGRES_USER=cinematch_user
POSTGRES_PASSWORD=cinematch_secure_password
POSTGRES_DB=cinematch_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cinematch_user:cinematch_secure_password@postgres:5432/cinematch_db

# ============================================================================
# CACHE - Redis
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=cinematch_redis_password
REDIS_DB=0
REDIS_URL=redis://:cinematch_redis_password@redis:6379/0

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_TITLE=CineMatch AI API
API_VERSION=1.0.0
API_DESCRIPTION=Collaborative Filtering Movie Recommendation Engine
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000,http://localhost:7860
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=100

# ============================================================================
# FRONTEND - Next.js Configuration
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GRADIO_URL=http://localhost:7860
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_ANALYTICS_ID=

# ============================================================================
# ML/AI CONFIGURATION
# ============================================================================
# ML Model Settings
ML_MODEL_NAME=svd_ensemble_v1
ML_CACHE_MODEL=True
ML_MODEL_UPDATE_INTERVAL=3600  # seconds (1 hour)
ML_DEFAULT_K=10
ML_MIN_USER_RATINGS=5

# SVD Hyperparameters
SVD_N_FACTORS=128
SVD_N_EPOCHS=30
SVD_LR_ALL=0.007
SVD_REG_ALL=0.08
SVD_BIASED=True

# Similarity Search
FAISS_INDEX_TYPE=IVF
FAISS_N_CLUSTERS=100
FAISS_METRIC=cosine

# Evaluation Metrics
EVAL_K_VALUES=5,10,20
EVAL_HIT_TARGET=0.65
EVAL_NDCG_TARGET=0.42
EVAL_COVERAGE_TARGET=0.40

# ============================================================================
# GRADIO CONFIGURATION
# ============================================================================
GRADIO_SHARE=False
GRADIO_ENABLE_QUEUE=True
GRADIO_MAX_QUEUE_SIZE=100

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=cinematch-dev
MLFLOW_RUN_NAME=local-development

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_ENABLED=True

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_URL=http://localhost:3001

# ============================================================================
# PGADMIN - Database Admin
# ============================================================================
PGADMIN_EMAIL=admin@cinematch.ai
PGADMIN_PASSWORD=admin

# ============================================================================
# AWS CONFIGURATION (For Production Deployment)
# ============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=cinematch-models
AWS_ECS_CLUSTER=cinematch-prod
AWS_ECS_SERVICE=cinematch-api

# ============================================================================
# DATA CONFIGURATION
# ============================================================================
# Dataset Configuration
DATASET_NAME=movielens_25m
DATASET_PATH=/app/data/movielens_25m
DATASET_MIN_RATINGS_PER_USER=20

# Cold-start Configuration
COLD_START_MIN_RATINGS=5
COLD_START_STRATEGY=popularity

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_ENABLE_ENSEMBLE=True
FEATURE_ENABLE_IMPLICIT_FEEDBACK=True
FEATURE_ENABLE_HYBRID_RECOMMENDATIONS=False
FEATURE_ENABLE_SOCIAL_FEATURES=False
FEATURE_ENABLE_A_B_TESTING=True

# ============================================================================
# CELERY (Background Tasks)
# ============================================================================
CELERY_BROKER_URL=redis://:cinematch_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:cinematch_redis_password@redis:6379/2
CELERY_TASK_ALWAYS_EAGER=True  # Set to False for production

# ============================================================================
# LOGGING
# ============================================================================
LOG_FILE=/app/logs/cinematch.log
LOG_FORMAT=json
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5

# ============================================================================
# EMAIL CONFIGURATION (For Notifications)
# ============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@cinematch.ai

# ============================================================================
# THIRD-PARTY SERVICES
# ============================================================================
# Sentry (Error Tracking) - Optional
SENTRY_DSN=

# Slack (Notifications) - Optional
SLACK_WEBHOOK_URL=

# ============================================================================
# TESTING
# ============================================================================
TESTING=False
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:
